# ─────────────────────────────────────────────────────────────
# YORUMICHI environment variables
# Copy to .env.local and fill in. Never commit real keys.
# ─────────────────────────────────────────────────────────────

# ── Development-only mock mode ───────────────────────────────
# true = development-only sample spots generated around your REAL location
# (no Google key needed). If ANTHROPIC_API_KEY is empty, a mock interpreter
# is used too. Ignored on Vercel production (VERCEL_ENV=production).
NEXT_PUBLIC_USE_MOCK_DATA=false

# ── Google Maps Platform ─────────────────────────────────────
# Browser key: Maps JavaScript API only. Restrict by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID (Advanced Markers + cloud styling). DEMO_MAP_ID works for development.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Server key: Places API (New) only. Never exposed to the browser.
# (Falls back to the browser key if empty — not recommended in production.)
GOOGLE_PLACES_API_KEY=

# ── AI ───────────────────────────────────────────────────────
# anthropic | mock | off   (off = never call the model; only spots that already have a line are shown)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Spot copy model / fast model (names the things cut out of photos) / effort
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_SHORTLIST_MODEL=claude-haiku-4-5
ANTHROPIC_EFFORT=low

# ── Supabase (optional) ─────────────────────────────────────
# All three set → Supabase (anonymous auth + DB + Storage).
# Otherwise stickers are kept in ./.data on the machine running the server
# (fine for local testing: a PC and a phone on the same server can place /
# send stickers to each other). Not for Vercel production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Needed because placing / sending stickers crosses users.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=stickers

# ── Sticker background removal (optional) ────────────────────
# Cutting out runs on the device (MediaPipe). remove.bg is only a fallback.
REMOVE_BG_API_KEY=

# ── Location ─────────────────────────────────────────────────
# The app ALWAYS uses the device's real position (browser Geolocation API).
# There is no built-in fallback coordinate.
#
# development-only: a fixed position, used ONLY when this is "true"
# AND both MOCK_LAT / MOCK_LNG are set. Keep false normally.
NEXT_PUBLIC_USE_MOCK_LOCATION=false
NEXT_PUBLIC_MOCK_LAT=
NEXT_PUBLIC_MOCK_LNG=

# all (default) = wherever the user is | tokyo = show a notice outside Tokyo
NEXT_PUBLIC_SERVICE_AREA=all

# ── Personal server (optional) ──────────────────────────────
# Without Supabase: every device that opens this server is treated as this one
# person, so a PC and a phone share one notebook. Leave empty for per-device users.
YORUMICHI_OWNER_ID=

# 外から開けるようにするときに設定する合言葉（空ならオフ）。各端末で一度 /?key=合言葉 を開く
YORIMICHI_ACCESS_KEY=

# 自分のサーバーで「送る」の届け先になるデモの住人（UUID をカンマ区切り）
YORUMICHI_DEMO_NEIGHBOURS=
